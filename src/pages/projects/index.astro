---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<Layout title="Projects">
  <section class="max-w-6xl mx-auto py-10 scroll-fade">

    <h1 class="text-4xl font-Epoch mb-10 scroll-fade">Projects</h1>

    <div class="grid gap-8 grid-cols-1 md:grid-cols-2 scroll-fade">
      {projects.map((project) => (
        <a 
          href={`/projects/${project.id}`} 
          class="card bg-base-200 shadow-xl hover:scale-[1.02] transition scroll-fade"
        >
          <div class="card-body flex items-center scroll-fade">

            <!-- LEFT SIDE: CENTERED TEXT -->
            <div class="flex flex-col flex-grow items-center justify-center text-center scroll-fade">
              <h2 class="card-title font-epoch text-2xl scroll-fade">
                {project.data.title}
              </h2>

              <p class="text-gray-600 scroll-fade">
                {project.data.shortDescription}
              </p>
            </div>

            <!-- RIGHT SIDE: ROUNDED-SQUARE LOGO -->
            {project.data.logo && (
              <div class="ml-4 scroll-fade flex-shrink-0">
                <img 
                  src={project.data.logo}
                  alt={`${project.data.title} logo`}
                  class="h-16 w-16 rounded-xl object-cover"
                />
              </div>
            )}

          </div>
        </a>
      ))}
    </div>

  </section>
</Layout>
