---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },  // ✔ use project.slug
    props: { project }
  }));
}


const { project } = Astro.props;

const isVideo = (src: string) => /\.(mp4|webm|mov)$/i.test(src);

const allImages = project.data.images ?? [];
const mainMedia = allImages[0];
const galleryMedia = allImages.slice(1);
---

<Layout title={project.data.title}>
  <section class="max-w-5xl mx-auto py-10 space-y-6 scroll-fade">

    <h1 class="text-4xl font-bold font-epoch mb-6 scroll-fade">{project.data.title}</h1>

    <div class="scroll-fade">

      <!-- MAIN MEDIA, FLOATED SO TEXT WRAPS AROUND IT -->
      {mainMedia && (
        <div class="float-right w-full sm:w-[450px] ml-0 sm:ml-8 mb-6 scroll-fade">
          <div class="w-full h-[450px] rounded-2xl overflow-hidden shadow-xl scroll-fade">
            {isVideo(mainMedia.src) ? (
              <video
                src={mainMedia.src}
                class="object-cover w-full h-full scroll-fade"
                muted
                loop
                playsinline
                autoplay
              />
            ) : (
              <img
                src={mainMedia.src}
                alt={project.data.title}
                class="object-cover w-full h-full scroll-fade"
              />
            )}
          </div>
          {mainMedia.caption && (
            <p class="mt-3 text-center text-gray-500 scroll-fade">{mainMedia.caption}</p>
          )}
        </div>
      )}

      <!-- TEXT, WRAPS AROUND THE FLOATED IMAGE -->
      <div class="text-lg leading-relaxed space-y-6 scroll-fade">
        {project.data.description
          .split("\n\n")
          .map((p) => <p class="scroll-fade">{p}</p>)}
      </div>

    </div>

    <div class="clear-both"></div>

    <!-- GALLERY -->
    {galleryMedia.length > 0 && (
  <div>
    <h2 class="text-3xl font-bold font-epoch mt-16 mb-6 scroll-fade">Gallery</h2>

    <!-- MEDIA GRID -->
    <div class="grid gap-10 sm:grid-cols-1 md:grid-cols-2 xl:grid-cols-2 scroll-fade">
      {galleryMedia.map((img) => (
        isVideo(img.src) ? (
          <div
            class="w-full h-[550px] rounded-2xl overflow-hidden shadow-xl cursor-pointer scroll-fade"
            onclick={`openLightbox('${img.src}', \`${img.caption || ""}\`, true)`}
          >
            <video
              src={img.src}
              class="object-cover w-full h-full hover:scale-105 transition duration-300"
              muted
              loop
              playsinline
              autoplay
            />
          </div>
        ) : (
          <div 
            class="w-full h-[550px] rounded-2xl overflow-hidden shadow-xl cursor-pointer scroll-fade"
            onclick={`openLightbox('${img.src}', \`${img.caption || ""}\`, false)`}
          >
            <img 
              src={img.src} 
              alt={project.data.title}
              class="object-cover w-full h-full hover:scale-105 transition duration-300"
            />
          </div>
        )
      ))}
    </div>

    <!-- LIGHTBOX OVERLAY -->
    <div 
      id="lightbox" 
      class="fixed inset-0 bg-black bg-opacity-80 z-50 hidden flex flex-col items-center justify-center p-6 text-white"
      onclick="closeLightbox()"
    >
      <img 
        id="lightbox-img" 
        src="" 
        class="max-w-[90vw] max-h-[80vh] rounded-xl shadow-2xl object-contain"
      />
      <video 
        id="lightbox-video" 
        src="" 
        class="max-w-[90vw] max-h-[80vh] rounded-xl shadow-2xl object-contain hidden"
        controls
        autoplay
        loop
      />

      <!-- CAPTION -->
      <p id="lightbox-caption" class="mt-4 text-center max-w-2xl text-lg opacity-90"></p>
    </div>

    <!-- LIGHTBOX SCRIPT -->
    <script is:inline>
      function openLightbox(src, caption, isVideo) {
        const img = document.getElementById("lightbox-img");
        const video = document.getElementById("lightbox-video");

        if (isVideo) {
          img.classList.add("hidden");
          video.classList.remove("hidden");
          video.src = src;
          video.currentTime = 0;
          video.play();
        } else {
          video.pause();
          video.classList.add("hidden");
          img.classList.remove("hidden");
          img.src = src;
        }

        document.getElementById("lightbox-caption").innerText = caption || "";
        document.getElementById("lightbox").classList.remove("hidden");
        document.body.style.overflow = "hidden";
      }

      function closeLightbox() {
        const video = document.getElementById("lightbox-video");
        video.pause();
        document.getElementById("lightbox").classList.add("hidden");
        document.body.style.overflow = "auto";
      }
    </script>
  </div>
)}

    <a href="/projects" 
   class="inline-block px-6 py-3 rounded-xl bg-teal-500 text-white 
          hover:bg-teal-600 transition mt-10 scroll-fade">
  ← Back to Projects
</a>

  </section>
</Layout>