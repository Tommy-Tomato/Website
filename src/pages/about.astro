---
import Layout from "../layouts/Layout.astro";
import about from "../content/about/about.json";
---

<Layout title="About Me">
  <section class="max-w-6xl mx-auto py-20 px-6 scroll-fade">
    
    <h1 class="text-4xl font-epoch mb-6 scroll-fade">About Me</h1>

    <div class="flex flex-col lg:flex-row gap-12 scroll-fade">

      <!-- LEFT COLUMN: TALL IMAGE -->
      <div class="flex-shrink-0 scroll-fade">
        <img 
          src="/images/about1.jpg"
          alt="Thomas Gonzalez photo 1"
          class="rounded-2xl shadow-lg w-[350px] h-[500px] object-cover scroll-fade"
        />
      </div>

      <!-- RIGHT COLUMN: 3 TOP IMAGES + TEXT -->
      <div class="flex flex-col gap-6 max-w-2xl scroll-fade">

        <!-- TOP ROW: 3 IMAGES -->
        <div class="grid grid-cols-3 gap-6 scroll-fade">
          <img 
            src="/images/about2.jpg"
            alt="Thomas Gonzalez photo 2"
            class="rounded-2xl shadow-lg w-full h-[250px] object-cover scroll-fade"
          />

          <img 
            src="/images/about3.jpg"
            alt="Thomas Gonzalez photo 3"
            class="rounded-2xl shadow-lg w-full h-[250px] object-cover scroll-fade"
          />

          <img 
            src="/images/about4.jpg"
            alt="Thomas Gonzalez photo 4"
            class="rounded-2xl shadow-lg w-full h-[250px] object-cover scroll-fade"
          />
        </div>

        <!-- TEXT -->
<div class="flex flex-col gap-4 scroll-fade">
  {about.aboutText.split('\n').map((paragraph) => (
    <p class="text-lg leading-relaxed scroll-fade">{paragraph}</p>
  ))}
</div>

      </div>

    </div>

  </section>
</Layout>
