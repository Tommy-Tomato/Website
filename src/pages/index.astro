---
import Layout from "../layouts/Layout.astro";
import home from "../content/home/home.json";
---

<Layout title="Home">

<!-- ============================= -->
<!--   INTRO HEADER SECTION        -->
<!-- ============================= -->
<section class="w-full py-20 px-10 flex flex-col lg:flex-row justify-between items-center gap-10 scroll-fade">

  <!-- LEFT SIDE: TEXT -->
  <div class="max-w-xl scroll-fade">
    <h1 class="text-6xl font-bold font-epoch leading-tight scroll-fade">
      {home.name}
    </h1>

    <p class="text-2xl text-gray-500 mt-4 scroll-fade">
      {home.tagline}
    </p>
  </div>

  <!-- RIGHT SIDE: IMAGES GRID -->
  <div class="grid grid-cols-2 grid-rows-2 gap-6 max-w-xl scroll-fade">
    {home.introMedia.map((item, i) => {
      const isVideo = /\.(mp4|webm|mov)$/i.test(item.src);
      const classes = `rounded-2xl object-cover scroll-fade ${i === 2 ? "col-span-2 h-64 w-full" : "h-56 w-56"}`;

      return isVideo ? (
        <video
          src={item.src}
          class={classes}
          autoplay
          muted
          loop
          playsinline
          aria-label={item.alt}
        />
      ) : (
        <img src={item.src} alt={item.alt} class={classes} />
      );
    })}
  </div>

</section>


<!-- ============================= -->
<!--         HERO SECTION          -->
<!-- ============================= -->
<section class="hero min-h-[70vh] bg-base-200 rounded-xl p-8 scroll-fade">
  <div class="hero-content flex-col lg:flex-row gap-10 scroll-fade">

    <!-- Left side: Text -->
    <div class="max-w-xl scroll-fade">
      <h1 class="text-5xl font-bold font-epoch scroll-fade">
        {home.heroTitle}
      </h1>

      <p class="py-6 text-lg leading-relaxed scroll-fade">
        {home.heroSubtitle}
      </p>

      <div class="flex gap-4 scroll-fade">
        <a href="/projects" class="btn bg-teal-600 hover:bg-teal-700 text-white border-none scroll-fade">
          View My Projects
        </a>

        <a href="/about" class="btn bg-transparent border-2 border-teal-600 text-teal-600 hover:bg-teal-50 scroll-fade">
          About Me
        </a>

        <a href={home.resumeUrl} class="btn bg-teal-500 hover:bg-teal-600 text-white border-none scroll-fade">
          Resume
        </a>
      </div>
    </div>

    <!-- Right side: Hero image -->
    <div class="w-[450px] h-[450px] rounded-xl bg-base-300 overflow-hidden flex items-center justify-center scroll-fade">
      <img
        src={home.heroImage}
        alt="Hero Image"
        class="object-cover w-full h-full scroll-fade"
      />
    </div>

  </div>
</section>

</Layout>