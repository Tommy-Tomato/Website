---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">

  <section class="max-w-3xl mx-auto mt-10 px-4">
    <h1 class="text-4xl font-bold mb-6">Contact Me</h1>

    <p class="text-lg mb-8">
      I'd love to connect! Whether it's about engineering, robotics, medical devices,
      or project opportunities — feel free to reach out.
    </p>

    <!-- Contact Card -->
    <div class="card bg-base-200 shadow-xl p-6">
      <h2 class="card-title mb-4">Get in Touch</h2>

<div class="flex flex-col gap-4">

  <!-- Email -->
  <a href="mailto:your_email@domain.com" class="btn btn-primary w-fit">
    📩 Email Me
  </a>

  <!-- LinkedIn -->
  <a
    href="https://www.linkedin.com"
    target="_blank"
    class="btn btn-outline w-fit"
  >
    🔗 LinkedIn
  </a>

  <!-- Resume -->
  <a
    href="/resume.pdf"
    target="_blank"
    class="btn btn-secondary w-fit"
  >
    📄 View Resume
  </a>

</div>

    </div>

  </section>

</Layout>
