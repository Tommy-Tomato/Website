---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">

  <section class="max-w-3xl mx-auto mt-10 px-4 scroll-fade">
    <h1 class="text-4xl font-Epoch mb-6 scroll-fade">Contact Me</h1>

    <p class="text-lg mb-8 scroll-fade">
      I'd love to connect!
    </p>

    <!-- Contact Card -->
    <div class="card bg-base-200 shadow-xl p-6 scroll-fade">
      <h2 class="card-title mb-4 scroll-fade">Get in Touch</h2>

      <div class="flex flex-col gap-4 scroll-fade">

        <!-- Email -->
        <a
          href="mailto:your_email@domain.com"
          class="btn bg-teal-600 hover:bg-teal-700 text-white border-none w-fit scroll-fade"
        >
          📩 Email Me
        </a>

        <!-- LinkedIn -->
<!-- LinkedIn Button -->
<a 
  href="https://www.linkedin.com/in/tgonza/"
  target="_blank"
  class="btn bg-transparent border-2 border-teal-600 text-teal-600 hover:bg-teal-50 w-fit flex items-center gap-2 scroll-fade"
>
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    fill="currentColor" 
    viewBox="0 0 24 24" 
    class="w-5 h-5"
  >
    <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1 4.98 2.12 4.98 3.5zM.5 8h4V24h-4V8zm7.5 0h3.8v2.16h.06c.53-1 1.82-2.16 3.74-2.16 4 0 4.74 2.63 4.74 6.06V24h-4v-8.37c0-2-.04-4.63-3-4.63-3 0-3.46 2.18-3.46 4.47V24h-4V8z"/>
  </svg>
  LinkedIn
</a>


        <!-- Resume -->
        <a
          href="/resume.pdf"
          target="_blank"
          class="btn bg-teal-500 hover:bg-teal-600 text-white border-none w-fit scroll-fade"
        >
          📄 View Resume
        </a>

      </div>

    </div>

  </section>

</Layout>
