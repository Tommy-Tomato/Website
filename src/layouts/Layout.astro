---
const {
  title = "Thomas Gonzalez",
  description = "Portfolio of Thomas Gonzalez — Mechanical Engineering student specializing in robotics, mechanical design, and hands-on engineering projects.",
  image = "/images/og-image.jpg",
  url = "https://Thomasgonzalez.netlify.app"
} = Astro.props;

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Page Title -->
    <title>{title ? `${title} | Thomas Gonzalez` : "Thomas Gonzalez"}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta name="author" content="Thomas Gonzalez" />
    <link rel="canonical" href={url} />

    <!-- Open Graph (LinkedIn, Discord, Facebook, Slack, iMessage) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={url} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Global Styles -->
    <link rel="stylesheet" href="/src/styles.css" />

    <!-- Slot for pages to inject extra head content -->
    <slot name="head" />
  </head>

  <body class="min-h-screen bg-base-100">
    <Navbar />

    <main class="p-6 pb-20">
      <slot />
    </main>

    <Footer />
  </body>
</html>
